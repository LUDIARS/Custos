# Custos 環境変数 (.env としてコピーすると tsx/electron/dotenv が読む)
# どれも空でも起動可。実運用に合わせて override する。

# ─── Ports ───────────────────────────────────────────
CUSTOS_PORT=7676              # backend (API + WS)
CUSTOS_FRONTEND_PORT=4649     # frontend (静的ファイル)
CUSTOS_HOST=0.0.0.0

# ブラウザに注入される backend URL。LAN 越しに使う場合は http://<host-ip>:7676 にする。
# 未設定時は CUSTOS_PORT から自動生成される。
# CUSTOS_BACKEND_URL=http://localhost:7676

# ─── Auth ────────────────────────────────────────────
CUSTOS_OPEN=1                 # "1" で認証スキップ (Cernere 不使用 / 開発時)
# CERNERE_URL=http://localhost:8080
# CORS_ORIGIN=*

# ─── Capture ─────────────────────────────────────────
# ffmpeg をフルパスで指したい場合
# CUSTOS_FFMPEG=C:\\tools\\ffmpeg\\bin\\ffmpeg.exe

# Android 関連
# CUSTOS_ADB=C:\\Android\\Sdk\\platform-tools\\adb.exe
# CUSTOS_AVFOUNDATION_INPUT=1:none

# ─── Apps config ────────────────────────────────────
# CUSTOS_APPS_FILE=./config/apps.json
