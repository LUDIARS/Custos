{
  "version": 1,
  "apps": [
    {
      "id": "adventurecube",
      "name": "AdventureCube (Debug)",
      "description": "AdventureCube の Debug ビルド。Vulkan + BPM ベースのアクション/リズム 3D ゲーム。",
      "target": "desktop",

      "build": {
        "workingDir": "E:/Document/Ars/AdventureCube",
        "cmd":  "cmake",
        "args": ["--build", "build", "--config", "Debug"],
        "timeoutSec": 900
      },
      "run": {
        "workingDir": "E:/Document/Ars/AdventureCube/build/Debug",
        "cmd":  "adventurecube.exe"
      },
      "test": {
        "workingDir": "E:/Document/Ars/AdventureCube",
        "cmd":  "ctest",
        "args": ["-C", "Debug", "--output-on-failure"]
      },

      "ergoCustos": {
        "host": "127.0.0.1",
        "port": 5198
      },
      "capture": {
        "type": "window",
        "windowTitle": "AdventureCube",
        "fps": 30,
        "preset": "veryfast"
      },
      "input": {
        "buttons": [
          { "label": "Forward",  "key": "W" },
          { "label": "Back",     "key": "S" },
          { "label": "Left",     "key": "A" },
          { "label": "Right",    "key": "D" },
          { "label": "↑",        "key": "Up" },
          { "label": "↓",        "key": "Down" },
          { "label": "←",        "key": "Left" },
          { "label": "→",        "key": "Right" },
          { "label": "Jump",     "key": "Space" },
          { "label": "Attack",   "key": "J" },
          { "label": "Skill",    "key": "K" },
          { "label": "Pause",    "key": "Escape" },
          { "label": "Quit",     "action": "kill" }
        ],
        "allowKeyboard": true,
        "allowMouse": true
      },
      "logs": { "stdout": true, "stderr": true, "files": [] }
    },

    {
      "id": "pictor-ocean-demo",
      "name": "Pictor Ocean Demo (Debug)",
      "description": "Pictor の海面テッセレーション + Gerstner 波 demo。Vulkan ウィンドウ。shader を ../shaders で拾うため workingDir は build/Debug。",
      "target": "desktop",

      "build": {
        "workingDir": "E:/Document/Ars/Pictor",
        "cmd":  "cmake",
        "args": ["--build", "build", "--config", "Debug", "--target", "pictor_ocean_demo"],
        "timeoutSec": 900
      },
      "run": {
        "workingDir": "E:/Document/Ars/Pictor/build/Debug",
        "cmd":  "pictor_ocean_demo.exe"
      },

      "capture": {
        "type": "window",
        "windowTitle": "Pictor — Ocean Wave Demo (Tessellation)",
        "fps": 30,
        "preset": "veryfast"
      },
      "input": {
        "buttons": [
          { "label": "Forward",   "key": "W" },
          { "label": "Back",      "key": "S" },
          { "label": "Left",      "key": "A" },
          { "label": "Right",     "key": "D" },
          { "label": "Up (E)",    "key": "E" },
          { "label": "Down (Q)",  "key": "Q" },
          { "label": "↑",         "key": "Up" },
          { "label": "↓",         "key": "Down" },
          { "label": "←",         "key": "Left" },
          { "label": "→",         "key": "Right" },
          { "label": "Wireframe", "key": "Tab" },
          { "label": "Pause",     "key": "Space" },
          { "label": "Quit",      "action": "kill" }
        ],
        "allowKeyboard": true,
        "allowMouse": true
      },
      "logs": { "stdout": true, "stderr": true, "files": [] }
    },

    {
      "id": "desktop-capture",
      "name": "Desktop Capture (WebRTC test)",
      "description": "デスクトップ全体を WebRTC で配信する検証用 entry。特定アプリのウィンドウに依存しないので、capture パイプライン (ffmpeg gdigrab desktop → RTP → werift) の疎通確認に使える。build/run/test は無く capture 専用。",
      "target": "desktop",

      "run": {
        "workingDir": ".",
        "cmd": "cmd.exe",
        "args": ["/c", "echo", "desktop-capture is a capture-only entry"]
      },

      "capture": {
        "type": "fullscreen",
        "fps": 15,
        "preset": "veryfast"
      },
      "input": {
        "buttons": [],
        "allowKeyboard": false,
        "allowMouse": false
      },
      "logs": { "stdout": true, "stderr": true, "files": [] }
    },

    {
      "id": "pictor-mobile-demo",
      "name": "Pictor Mobile Demo",
      "description": "Pictor の mobile pipeline simulation (headless console)。",
      "target": "desktop",

      "build": {
        "workingDir": "E:/Document/Ars/Pictor",
        "cmd":  "cmake",
        "args": ["--build", "build", "--config", "Debug", "--target", "pictor_mobile_demo"],
        "timeoutSec": 600
      },
      "run": {
        "workingDir": "E:/Document/Ars/Pictor/build/Debug",
        "cmd":  "pictor_mobile_demo.exe",
        "args": ["--profile=MobileLow", "--frames=120"]
      },

      "input": {
        "buttons": [
          { "label": "Quit", "action": "kill" }
        ],
        "allowKeyboard": false,
        "allowMouse": false
      }
    }
  ]
}
