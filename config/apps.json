        {
            "id": "PrivateGame-editor",
            "name": "PrivateGame (Unity Editor PlayMode)",
            "description": "起動済みの Unity Editor を駆動するモード。Build = UnityCommandServer (port 8686) の /api/recompile + compile-status ポーリング、Run = /api/play-start + isPlaying ポーリングループ。キー入力・スクリーンショット・WebRTC 動画は com.ludiars.custos-bridge (port 17778) 経由: /key で InputSystem に直接注入、/screenshot で Game View スナップショット、/stream で Game View を毎フレーム AsyncGPUReadback して raw BGRA を Custos に流し ffmpeg→werift で WebRTC 配信する (ホスト nut-js / gdigrab を bypass)。導入は KzSUnity の Packages/manifest.json に local path 追加 → プロジェクトルートに custos_bridge.json (port 17778) → メニュー LUDIARS/Custos Bridge/Enabled。captureMode (camera/window/auto) は custos_bridge.json 側。Custos kill 時は PowerShell の finally で /api/play-stop を試みるが、taskkill /F だと走らないので Editor 側で手動 Stop が必要なことがある。",
            "target": "desktop",
            "inAppBridge": {
                "kind": "unity",
                "host": "127.0.0.1",
                "port": 17778,
                "fps": 24
            },
            "build": {
                "workingDir": "E:/Document/PrivateGame/KzSUnity",
                "cmd": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-NonInteractive",
                    "-Command",
                    "$ErrorActionPreference='Stop'; Invoke-RestMethod -Method POST -Uri http://localhost:8686/api/recompile | Out-Null; do { Start-Sleep -Milliseconds 500; $s = Invoke-RestMethod http://localhost:8686/api/compile-status } while ($s.isCompiling); if ($s.hasErrors) { $s.errors | ConvertTo-Json -Depth 4; exit 1 } else { Write-Host 'Compile OK' }"
                ],
                "timeoutSec": 600
            },
            "run": {
                "workingDir": "E:/Document/PrivateGame/KzSUnity",
                "cmd": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-NonInteractive",
                    "-Command",
                    "try { Invoke-RestMethod -Method POST -Uri http://localhost:8686/api/play-start | Out-Null; Write-Host 'PlayMode started'; while ($true) { Start-Sleep -Milliseconds 800; try { $s = Invoke-RestMethod http://localhost:8686/api/play-status; if (-not $s.isPlaying) { Write-Host 'PlayMode stopped'; break } } catch { Write-Host 'status poll failed — Editor closed?'; break } } } finally { try { Invoke-RestMethod -Method POST -Uri http://localhost:8686/api/play-stop | Out-Null } catch {} }"
                ]
            },
            "capture": {
                "type": "window",
                "windowTitle": "PrivateGame",
                "fps": 30,
                "preset": "veryfast"
            },
            "input": {
                "buttons": [
                    {
                        "label": "↑ W",
                        "key": "W"
                    },
                    {
                        "label": "↓ S",
                        "key": "S"
                    },
                    {
                        "label": "← A",
                        "key": "A"
                    },
                    {
                        "label": "→ D",
                        "key": "D"
                    },
                    {
                        "label": "Jump",
                        "key": "Space"
                    },
                    {
                        "label": "Slide",
                        "key": "LShift"
                    },
                    {
                        "label": "Curve L",
                        "key": "Q"
                    },
                    {
                        "label": "Curve R",
                        "key": "E"
                    },
                    {
                        "label": "A Attack",
                        "key": "F"
                    },
                    {
                        "label": "B (1)",
                        "key": "Num1"
                    },
                    {
                        "label": "X (2)",
                        "key": "Num2"
                    },
                    {
                        "label": "Y (3)",
