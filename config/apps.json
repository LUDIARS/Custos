{
  "version": 1,
  "apps": [
    {
      "id": "adventurecube",
      "name": "AdventureCube (Debug)",
      "description": "AdventureCube の Debug ビルドを起動。Vulkan + BPM ベースのアクション/リズム 3D ゲーム。run.bat と同等の挙動を再現するため cwd は build/Debug (shaders/ パスを ../shaders として解決させる)。",
      "target": "desktop",
      "build": {
        "cwd": "E:/Document/Ars/AdventureCube",
        "cmd": "cmake",
        "args": ["--build", "build", "--config", "Debug"],
        "timeoutSec": 900
      },
      "run": {
        "cwd": "E:/Document/Ars/AdventureCube/build/Debug",
        "cmd": "adventurecube.exe"
      },
      "test": {
        "cwd": "E:/Document/Ars/AdventureCube",
        "cmd": "ctest",
        "args": ["-C", "Debug", "--output-on-failure"]
      },
      "capture": {
        "type": "window",
        "windowTitle": "AdventureCube",
        "fps": 30,
        "preset": "veryfast"
      },
      "input": {
        "buttons": [
          { "label": "Forward",  "key": "W" },
          { "label": "Back",     "key": "S" },
          { "label": "Left",     "key": "A" },
          { "label": "Right",    "key": "D" },
          { "label": "Jump",     "key": "Space" },
          { "label": "Attack",   "key": "J" },
          { "label": "Skill",    "key": "K" },
          { "label": "Pause",    "key": "Escape" },
          { "label": "Quit",     "action": "kill" }
        ],
        "allowKeyboard": true,
        "allowMouse": true
      },
      "logs": { "stdout": true, "stderr": true, "files": [] }
    },
    {
      "id": "pictor-ocean-demo",
      "name": "Pictor Ocean Demo (Debug)",
      "description": "Pictor の海面テッセレーション + Gerstner 波 demo。Vulkan ウィンドウ。shader を ../shaders で拾うため cwd は build/Debug。",
      "target": "desktop",
      "build": {
        "cwd": "E:/Document/Ars/Pictor",
        "cmd": "cmake",
        "args": ["--build", "build", "--config", "Debug", "--target", "pictor_ocean_demo"],
        "timeoutSec": 900
      },
      "run": {
        "cwd": "E:/Document/Ars/Pictor/build/Debug",
        "cmd": "pictor_ocean_demo.exe"
      },
      "capture": {
        "type": "window",
        "windowTitle": "Pictor — Ocean Wave Demo (Tessellation)",
        "fps": 30,
        "preset": "veryfast"
      },
      "input": {
        "buttons": [
          { "label": "Forward",   "key": "W" },
          { "label": "Back",      "key": "S" },
          { "label": "Left",      "key": "A" },
          { "label": "Right",     "key": "D" },
          { "label": "Up",        "key": "E" },
          { "label": "Down",      "key": "Q" },
          { "label": "Wireframe", "key": "Tab" },
          { "label": "Pause",     "key": "Space" },
          { "label": "Quit",      "action": "kill" }
        ],
        "allowKeyboard": true,
        "allowMouse": true
      },
      "logs": { "stdout": true, "stderr": true, "files": [] }
    },
    {
      "id": "pictor-mobile-demo",
      "name": "Pictor Mobile Demo",
      "description": "Pictor の mobile pipeline simulation (headless console)。",
      "target": "desktop",
      "build": {
        "cwd": "E:/Document/Ars/Pictor",
        "cmd": "cmake",
        "args": ["--build", "build", "--config", "Debug", "--target", "pictor_mobile_demo"],
        "timeoutSec": 600
      },
      "run": {
        "cwd": "E:/Document/Ars/Pictor/build/Debug",
        "cmd": "pictor_mobile_demo.exe",
        "args": ["--profile=MobileLow", "--frames=120"]
      },
      "input": {
        "buttons": [
          { "label": "Quit", "action": "kill" }
        ],
        "allowKeyboard": false,
        "allowMouse": false
      }
    }
  ]
}
