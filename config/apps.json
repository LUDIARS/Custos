        "type": "fullscreen",
        "fps": 15,
        "preset": "veryfast"
      },
      "input": {
        "buttons": [],
        "allowKeyboard": false,
        "allowMouse": false
      },
      "logs": { "stdout": true, "stderr": true, "files": [] }
