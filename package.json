{
  "name": "custos",
  "version": "0.1.0",
  "private": true,
  "description": "LUDIARS remote test runner — build/run/inspect target apps with virtual keys, log streaming, and (planned) WebRTC screen capture.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "serve": "tsx src/main.ts",
    "serve:open": "cross-env CUSTOS_OPEN=1 tsx src/main.ts",
    "start": "electron .",
    "start:open": "cross-env CUSTOS_OPEN=1 electron .",
    "app": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono":              "^4.6.10",
    "pino":              "^9.5.0",
    "pino-pretty":       "^11.3.0",
    "werift":            "^0.22.4",
    "ws":                "^8.18.0",
    "zod":               "^3.23.8"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0"
  },
  "devDependencies": {
    "@types/node":   "^22.9.0",
    "@types/ws":     "^8.5.13",
    "cross-env":     "^7.0.3",
    "electron":      "^33.0.0",
    "tsx":           "^4.19.2",
    "typescript":    "^5.6.3",
    "vitest":        "^3.2.0"
  }
}
